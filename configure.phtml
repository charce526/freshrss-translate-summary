<?php

if (!isset($this) || !$this instanceof TranslateSummaryExtension) {
    return;
}

$baseUrl = $this->getConfigValue('api_base_url');
$apiKey = $this->getConfigValue('api_key');
$model = $this->getConfigValue('model');
$translatePrompt = $this->getConfigValue('translate_prompt');
$summaryPrompt = $this->getConfigValue('summary_prompt');

if ($baseUrl === '') {
    $baseUrl = 'https://api.openai.com/v1';
}

if ($model === '') {
    $model = 'gpt-3.5-turbo';
}

if ($translatePrompt === '') {
    $translatePrompt = '请将以下内容翻译为中文，并尽可能保留原有 HTML 结构。';
}

if ($summaryPrompt === '') {
    $summaryPrompt = '请使用中文简明总结以下内容，提炼关键要点。';
}

?>
<form method="post" action="<?php echo _url('extension', 'configure', 'e', urlencode($this->getName())); ?>" data-auto-leave-validation="1">
    <input type="hidden" name="_csrf" value="<?php echo htmlspecialchars(FreshRSS_Auth::csrfToken(), ENT_QUOTES, 'UTF-8'); ?>">

    <fieldset class="form-group">
        <legend>OpenAI 兼容 API</legend>

        <div class="form-group">
            <label class="group-name" for="translate-cn-api-base-url">API 基础地址</label>
            <div class="group-controls">
                <input id="translate-cn-api-base-url" name="api_base_url" type="text" value="<?php echo htmlspecialchars($baseUrl, ENT_QUOTES, 'UTF-8'); ?>" placeholder="https://api.openai.com/v1">
                <p class="help">示例：https://api.openai.com/v1</p>
            </div>
        </div>

        <div class="form-group">
            <label class="group-name" for="translate-cn-api-key">API 密钥</label>
            <div class="group-controls">
                <input id="translate-cn-api-key" name="api_key" type="password" value="<?php echo htmlspecialchars($apiKey, ENT_QUOTES, 'UTF-8'); ?>" autocomplete="new-password">
            </div>
        </div>

        <div class="form-group">
            <label class="group-name" for="translate-cn-model">模型名称</label>
            <div class="group-controls">
                <input id="translate-cn-model" name="model" type="text" value="<?php echo htmlspecialchars($model, ENT_QUOTES, 'UTF-8'); ?>" placeholder="gpt-4o">
            </div>
        </div>

        <div class="form-group">
            <label class="group-name" for="translate-cn-translate-prompt">翻译提示词</label>
            <div class="group-controls">
                <textarea id="translate-cn-translate-prompt" name="translate_prompt" rows="4"><?php echo htmlspecialchars($translatePrompt, ENT_QUOTES, 'UTF-8'); ?></textarea>
                <p class="help">翻译时使用的系统提示词。</p>
            </div>
        </div>

        <div class="form-group">
            <label class="group-name" for="translate-cn-summary-prompt">摘要提示词</label>
            <div class="group-controls">
                <textarea id="translate-cn-summary-prompt" name="summary_prompt" rows="4"><?php echo htmlspecialchars($summaryPrompt, ENT_QUOTES, 'UTF-8'); ?></textarea>
                <p class="help">生成摘要时使用的系统提示词。</p>
            </div>
        </div>
    </fieldset>

    <div class="form-group form-actions">
        <div class="group-controls">
            <button class="btn btn-important" type="submit">保存设置</button>
        </div>
    </div>
</form>
