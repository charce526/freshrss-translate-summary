<?php

if (!isset($this) || !$this instanceof TranslateSummaryExtension) {
    return;
}

$profiles = $this->getApiProfiles();
$requestTimeout = $this->getRequestTimeout();
$connectTimeout = $this->getConnectTimeout();
$translatePrompt = $this->getConfigValue('translate_prompt');
$summaryPrompt = $this->getConfigValue('summary_prompt');

if ($translatePrompt === '') {
    $translatePrompt = '请将以下内容翻译为中文，并尽可能保留原有 HTML 结构。';
}

if ($summaryPrompt === '') {
    $summaryPrompt = '请使用中文简明总结以下内容，提炼关键功能、新增内容、修复问题和重要变更。仅返回可直接插入网页的 HTML 片段，不要使用 Markdown，不要输出代码围栏、星号粗体、井号标题或 Markdown 列表标记；不要输出 html、head、body 标签。使用 p、h3、ul、li、strong、code 等 HTML 标签组织内容，只输出最终摘要，不要解释输出格式。';
}

$profilesJson = json_encode($profiles, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
if (!is_string($profilesJson)) {
    $profilesJson = '[]';
}
?>
<form method="post" action="<?php echo _url('extension', 'configure', 'e', urlencode($this->getName())); ?>" data-auto-leave-validation="1" id="translate-cn-settings-form">
    <input type="hidden" name="_csrf" value="<?php echo htmlspecialchars(FreshRSS_Auth::csrfToken(), ENT_QUOTES, 'UTF-8'); ?>">
    <input type="hidden" id="translate-cn-api-profiles" name="api_profiles" value="<?php echo htmlspecialchars($profilesJson, ENT_QUOTES, 'UTF-8'); ?>">

    <fieldset class="form-group">
        <legend>API 与模型配置</legend>
        <p class="help">可以添加多个 OpenAI 兼容 API 与模型。文章工具栏会显示配置名称和模型名称，但不会暴露 API 密钥。</p>
        <div id="translate-cn-profile-list" class="translate-cn-profile-list"></div>
        <div class="translate-cn-profile-actions">
            <button class="btn" type="button" id="translate-cn-add-profile">添加配置</button>
            <span class="help">最多可保存 20 个配置。同一 API 使用多个模型时，可以复用地址和密钥。</span>
        </div>
    </fieldset>

    <fieldset class="form-group">
        <legend>通用设置</legend>
        <div class="form-group">
            <label class="group-name" for="translate-cn-request-timeout">请求超时</label>
            <div class="group-controls">
                <input id="translate-cn-request-timeout" name="request_timeout" type="number" min="10" max="600" step="1" value="<?php echo $requestTimeout; ?>">
                <p class="help">等待 API 完成响应的最长时间，单位为秒。默认 180 秒，可填写 10–600。</p>
            </div>
        </div>
        <div class="form-group">
            <label class="group-name" for="translate-cn-connect-timeout">连接超时</label>
            <div class="group-controls">
                <input id="translate-cn-connect-timeout" name="connect_timeout" type="number" min="1" max="120" step="1" value="<?php echo $connectTimeout; ?>">
                <p class="help">与 API 服务器建立连接的最长时间，单位为秒。默认 30 秒，可填写 1–120。</p>
            </div>
        </div>
        <div class="form-group">
            <label class="group-name" for="translate-cn-translate-prompt">翻译提示词</label>
            <div class="group-controls">
                <textarea id="translate-cn-translate-prompt" name="translate_prompt" rows="4"><?php echo htmlspecialchars($translatePrompt, ENT_QUOTES, 'UTF-8'); ?></textarea>
                <p class="help">所有 API 配置共用的翻译系统提示词。</p>
            </div>
        </div>
        <div class="form-group">
            <label class="group-name" for="translate-cn-summary-prompt">摘要提示词</label>
            <div class="group-controls">
                <textarea id="translate-cn-summary-prompt" name="summary_prompt" rows="6"><?php echo htmlspecialchars($summaryPrompt, ENT_QUOTES, 'UTF-8'); ?></textarea>
                <p class="help">所有 API 配置共用的摘要系统提示词。</p>
            </div>
        </div>
    </fieldset>

    <div class="form-group form-actions">
        <div class="group-controls">
            <button class="btn btn-important" type="submit">保存设置</button>
        </div>
    </div>
</form>

<script src="<?php echo htmlspecialchars($this->getFileUrl('configure.js'), ENT_QUOTES, 'UTF-8'); ?>"></script>
